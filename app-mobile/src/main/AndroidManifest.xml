<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Yakalama: kamerayı ekrana doğrultma (yol haritası "Yakalama" #1).
         Konsol bağlantısı (MediaProjection) ileride ayrı bir izin akışıyla
         eklenecek. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!-- P3/G022-G030 (telefon↔TV cue taşıma, core-transport): "TV'ye
         Yansıt" özelliği, kullanıcının elle girdiği TV IP/port'una düz bir
         TCP soketiyle bağlanır. Bu, HTTP(S) değildir; `usesCleartextTraffic`
         aşağıda `false` olsa da bu bayrak yalnızca platformun ağ güvenliği
         yapılandırmasına uyan istekleri (HttpsURLConnection/okhttp vb.)
         kapsar, çiğ `java.net.Socket` kullanımını etkilemez — bu yine de
         şifrelenmemiş bir bağlantıdır (bkz. core-transport modül notu,
         G023-G024 TLS henüz eklenmedi). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="GAMLETSOL"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="false">

        <!-- NOT (2026-11-09): Gerçek bir marka/logo tasarlandı ve adaptive
             icon olarak eklendi (res/mipmap-anydpi-v26/ic_launcher.xml +
             res/mipmap-*/ic_launcher_background.png/ic_launcher_foreground.png)
             — önceden burada sistemin genel yer tutucu simgesi
             (`@android:drawable/sym_def_app_icon`) kullanılıyordu. Simgenin
             gerçek bir cihazın başlatıcısında (launcher) nasıl
             render edildiği bu kum havuzunda denenmedi (Android SDK yok) —
             yalnızca CI'daki gerçek `assembleDebug` derlemesiyle
             doğrulandı. -->

        <!-- Gizlilik ilkesi (bkz. kök README.md / yol haritası "Gizlilik
             ilkesi"): kamera görüntüsü asla sunucuya yüklenmez; yalnız OCR
             ile çıkarılan altyazı metni, kullanıcı çeviriyi açtıysa ML Kit'in
             cihaz-üstü modeline (varsayılan) ya da ileride bir bulut çeviri
             servisine (P6, ayrı onay gerektirir) gider. -->
        <!-- Yön (2026-11-13): Uygulama artık dikey VE yatay kullanılabilir
             (önceden `screenOrientation="portrait"` ile kilitliydi; kullanıcı
             yatay kullanım istedi). Sistemin otomatik döndürme ayarına uyar.
             `configChanges` nedeniyle döndürmede Activity yeniden
             oluşturulmaz (kamera/çeviri hattı ve açık diyaloglar korunur);
             CameraX use-case'lerinin hedef dönüşü bunun yerine
             `DisplayRotationEffect` ile güncellenir. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
