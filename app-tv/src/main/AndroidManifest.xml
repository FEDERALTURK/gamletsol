<?xml version="1.0" encoding="utf-8"?>
<!--
  Herhangi bir Android TV / Google TV cihazında kurulabilen genel bir
  kanıt (probe) uygulaması. `android.software.leanback` özelliği
  "required=false" bırakıldı ki geliştirme sırasında normal bir telefon/
  tablette de (TV arayüzü olmadan, sadece debug amaçlı) kurulup
  denenebilsin; gerçek hedef her zaman bir Android TV / Google TV
  cihazıdır.

  NOT (dürüstlük ilkesi): `android:banner` burada basit bir placeholder
  drawable'a işaret ediyor — gerçek bir marka/logo tasarımı DEĞİLDİR,
  yalnızca LEANBACK_LAUNCHER kategorisinin TV ana ekranında bir kart
  gösterebilmesi için var.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- P3/G022-G030 (telefon↔TV cue taşıma, core-transport): bu uygulama
         yerel ağda bir TCP sunucusu açıp telefondan gelen altyazı/çeviri
         olaylarını dinler. İnternete çıkmaz, yalnızca aynı yerel ağdaki
         telefonla konuşur — ama Android, soket açmak için her durumda
         INTERNET iznini ister. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_probe_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.GamletsolTv">

        <!-- NOT (lint uyarısı, bilerek bastırıldı): TV uygulaması TANIM
             GEREĞİ sabit `landscape` — Android TV cihazlarında döndürme
             kavramı yok, bu yüzden `LockedOrientationActivity`/
             `DiscouragedApi` uyarısı burada uygulanamaz bir öneridir. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GamletsolTv"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
