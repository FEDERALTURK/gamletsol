<?xml version="1.0" encoding="utf-8"?>
<!--
  Herhangi bir Android TV / Google TV cihazında kurulabilen genel bir
  kanıt (probe) uygulaması. `android.software.leanback` özelliği
  "required=false" bırakıldı ki geliştirme sırasında normal bir telefon/
  tablette de (TV arayüzü olmadan, sadece debug amaçlı) kurulup
  denenebilsin; gerçek hedef her zaman bir Android TV / Google TV
  cihazıdır.

  NOT (2026-11-09): `android:banner` ve `android:icon` artık gerçek bir
  marka/logo kullanıyor (bkz. res/drawable-xhdpi/gamletsol_tv_banner.png +
  res/mipmap-anydpi-v26/ic_launcher.xml) — önceden ikisi de basit
  placeholder'dı. Gerçek bir TV'nin LEANBACK_LAUNCHER ana ekranında nasıl
  render edildiği bu kum havuzunda denenmedi (Android SDK yok), yalnızca
  CI'daki gerçek `assembleDebug` derlemesiyle doğrulandı.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- P3/G022-G030 (telefon↔TV cue taşıma, core-transport): bu uygulama
         yerel ağda bir TCP sunucusu açıp telefondan gelen altyazı/çeviri
         olaylarını dinler. İnternete çıkmaz, yalnızca aynı yerel ağdaki
         telefonla konuşur — ama Android, soket açmak için her durumda
         INTERNET iznini ister. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/gamletsol_tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.GamletsolTv">

        <!-- NOT (lint uyarısı, bilerek bastırıldı): TV uygulaması TANIM
             GEREĞİ sabit `landscape` — Android TV cihazlarında döndürme
             kavramı yok, bu yüzden `LockedOrientationActivity`/
             `DiscouragedApi` uyarısı burada uygulanamaz bir öneridir. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.GamletsolTv"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
